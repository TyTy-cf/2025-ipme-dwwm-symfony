{% extends 'front/base.html.twig' %}

{% block title %}SteamIsh V3{% endblock %}

{% block body %}

    <div class="container">
        <h1 class="text-center mt-4">SteamIsh V3</h1>

{#        <div class="row">#}
{#            {% for review in lastReviews %}#}
{#                <div class="col-lg-3">#}
{#                    {{ review.createdAt|date('d/m/Y') }}#}
{#                    {{ review.rating }}/5#}
{#                </div>#}
{#            {% endfor %}#}
{#        </div>#}

        {% include 'front/partials/_game_loop.html.twig' with {
            'title': 'Les dernières sorties',
            'games': lastGames
        } %}


        {% include 'front/partials/_game_loop.html.twig' with {
            'title': 'Les meilleures offres',
            'games': expensiveGames
        } %}

        {% include 'front/partials/common/_review_loop.html.twig' %}

        {% include 'front/partials/_game_loop.html.twig' with {
            'title': 'Les tendances actuelles',
            'games': bestSellers
        } %}

        <div class="row mt-2">
            {% for category in categories %}
                <div class="col-lg-4 col-md-6 col-sm-12 mb-2">
                    <a class="default-link"
                       href="{{ path('app_show_category', {'slug': category.slug}) }}"
                    >
                        <h3 class="text-center">{{ category.name }}</h3>
                    </a>
                </div>
            {% endfor %}
        </div>

        {% include 'front/partials/_game_loop.html.twig' with {
            'title': 'Les plus joués',
            'games': mostPlayedGames
        } %}
    </div>


{% endblock %}
